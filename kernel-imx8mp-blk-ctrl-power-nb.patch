pmdomain: imx8mp-blk-ctrl: register the GPC notifier the chain added.

Adapted from
  https://cdn.kernel.org/pub/linux/kernel/v6.x/incr/patch-6.12.69-70.xz

6.12.69-70 moved the power-domain notifier onto each domain so a busy domain can
veto a PRE_OFF power-down. The chain applied the notifier function but neither
the struct member it hangs off nor the dev_pm_genpd_add_notifier() calls, so the
container_of() does not compile and the code would be dead. The hunks below add
the member and the add/remove calls, which is what that level does.

--- a/drivers/pmdomain/imx/imx8mp-blk-ctrl.c
+++ b/drivers/pmdomain/imx/imx8mp-blk-ctrl.c
@@ -83,6 +83,7 @@
 	struct clk_bulk_data clks[DOMAIN_MAX_CLKS];
 	struct device *power_dev;
 	struct imx8mp_blk_ctrl *bc;
+	struct notifier_block power_nb;
 	int id;
 };
 
@@ -836,6 +837,14 @@
 			goto cleanup_pds;
 		}
 
+		domain->power_nb.notifier_call = imx8mp_blk_ctrl_gpc_notifier;
+		ret = dev_pm_genpd_add_notifier(domain->power_dev, &domain->power_nb);
+		if (ret) {
+			dev_err_probe(dev, ret, "failed to add power notifier\\n");
+			dev_pm_domain_detach(domain->power_dev, true);
+			goto cleanup_pds;
+		}
+
 		domain->genpd.name = data->name;
 		domain->genpd.power_on = imx8mp_blk_ctrl_power_on;
 		domain->genpd.power_off = imx8mp_blk_ctrl_power_off;
@@ -911,6 +920,7 @@
 	for (i--; i >= 0; i--) {
 		pm_genpd_remove(&bc->domains[i].genpd);
 		dev_pm_genpd_remove_notifier(bc->domains[i].power_dev);
+		dev_pm_genpd_remove_notifier(bc->domains[i].power_dev);
 		dev_pm_domain_detach(bc->domains[i].power_dev, true);
 	}
 
@@ -931,6 +941,7 @@
 
 		pm_genpd_remove(&domain->genpd);
 		dev_pm_genpd_remove_notifier(domain->power_dev);
+		dev_pm_genpd_remove_notifier(domain->power_dev);
 		dev_pm_domain_detach(domain->power_dev, true);
 	}
 
